{
  "name": "snake-game",
  "version": "2.0.0",
  "description": "Classic Snake Game built with TypeScript and the browser canvas/DOM, featuring a modular design.",
  "homepage": "https://github.com/aliammari1/games/tree/main/snake-game",
  "license": "MIT",
  "author": "Ali Ammari",
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.49.1",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^2.1.8",
    "serve": "^14.2.4",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "serve build",
    "preview": "serve build",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  }
}
